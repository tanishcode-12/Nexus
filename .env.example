# Copy this file to .env and fill in real values. Every variable Nexus
# reads is listed here (see config.py) — nothing is configured anywhere else.

# --- OmniRoute connection (required) ---
OMNIROUTE_BASE_URL=http://localhost:8787
OMNIROUTE_API_KEY=

# --- Model defaults ---
NEXUS_DEFAULT_MODEL=gpt-4o-mini
# Leave blank to disable automatic fallback-on-failure (Section 8).
NEXUS_FALLBACK_MODEL=

# --- Auth & scoping (Section 3) ---
# Path to a JSON file mapping API keys to scopes/per-key rate overrides.
# See keys.json.example for the format. Never commit your real keys.json.
NEXUS_KEYS_FILE=keys.json

# --- Rate limiting & quotas (Section 4) ---
# Per-key overrides live in keys.json; these are the defaults for any key
# without an override.
NEXUS_RATE_CAPACITY=20
NEXUS_RATE_REFILL_PER_SEC=0.5
NEXUS_DAILY_QUOTA=500
NEXUS_MONTHLY_QUOTA=10000
# Where daily/monthly request counters are persisted (SQLite file path).
NEXUS_DB_PATH=nexus_quota.sqlite3

# --- Caching (Section 5) ---
# "memory" (default, single-process/dev) or "redis" (multi-process/prod).
NEXUS_CACHE_BACKEND=memory
NEXUS_REDIS_URL=redis://localhost:6379/0
NEXUS_CACHE_TTL_SECONDS=600

# --- HTTP transport ---
NEXUS_HTTP_HOST=0.0.0.0
NEXUS_HTTP_PORT=8080

# --- Observability ---
# DEBUG, INFO, WARNING, ERROR
NEXUS_LOG_LEVEL=INFO
